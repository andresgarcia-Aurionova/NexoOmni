# ============================================================
# REQUIRED â€” the app won't start without these.
# ============================================================

# Supabase (Project Settings â†’ API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase service-role key. Bypasses RLS; used only by server-side
# routes (the webhook, automation engine, and the public API key
# auth path â€” see docs/public-api.md). Keep this secret â€” never
# paste it into client code.
#
# Note: the public API (/api/v1) needs no new env var. API keys are
# created in the dashboard (Settings â†’ API keys) and stored hashed
# in the database; this service-role key is what lets the auth path
# look a presented key up without a user session.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# WhatsApp token encryption (64 hex chars = 32 bytes, AES-256-GCM).
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating this value orphans every token encrypted under the previous
# key â€” users have to re-save their WhatsApp settings to reconnect.
ENCRYPTION_KEY=your-64-char-hex-key-here

# Meta App Secret (Meta for Developers â†’ App Settings â†’ Basic).
# Verifies the HMAC-SHA256 signature on every inbound webhook POST.
# Required â€” without it the webhook rejects every request.
META_APP_SECRET=your-meta-app-secret

# ============================================================
# RECOMMENDED â€” safe defaults exist but you'll want to set these.
# ============================================================

# Canonical public URL of this deployment (scheme + host, no trailing
# slash). Used for the sitemap and OG images. Routes that need a
# self-referential URL (invite links from /api/account/invitations,
# any future email-bound link) derive the origin from the request
# itself, so this variable is *only* needed when the request-derived
# origin would be wrong â€” e.g. when generating links from a cron job
# or a background worker that has no incoming request.
NEXT_PUBLIC_SITE_URL=https://crm.example.com

# Default language locale (e.g. en)
NEXT_PUBLIC_APP_LOCALE=en

# ============================================================
# OPTIONAL â€” only needed if you use the feature.
# ============================================================

# Defense-in-depth allow-list for the hostnames that
# /api/account/invitations is willing to publish in invite URLs.
# Comma-separated, no scheme, no port (just hostnames).
#
# Why this exists: when NEXT_PUBLIC_SITE_URL is unset, invite URLs
# are derived from the incoming request's `Host` / `X-Forwarded-
# Host` header. On a typical proxied deploy the proxy sets these
# to your canonical hostname and they're trustworthy. On a *bare*
# deployment exposed to the public internet, an attacker could
# POST to the API directly with a spoofed `Host: phishing.example`
# and receive an invite URL pointing at their site.
#
# When this var is set, hostnames not on the list are rejected
# (the request falls through to the wacrm.tech fallback with a
# console.warn). When unset, behavior is unchanged from earlier
# versions â€” the request-derived host is trusted.
#
# Most operators don't need this: setting NEXT_PUBLIC_SITE_URL to
# your canonical URL already pins invite links there. This is for
# operators who want belt-and-braces or run multi-tenant setups
# where one app instance serves several hostnames.
#
# Example:
#   ALLOWED_INVITE_HOSTS=crm.example.com,crm-staging.example.com

# Shared secret protecting GET /api/automations/cron. Required if you
# use Wait steps in automations (a scheduled pinger drains pending
# executions). Generate any long random string:
#   openssl rand -hex 32
# See docs/automations-and-cron.md.
# AUTOMATION_CRON_SECRET=generate-a-long-random-string

# Web Push notifications for incoming messages assigned to an agent.
# Generate a VAPID key pair with:
#   npx web-push generate-vapid-keys --json
# The browser retrieves the public key from the authenticated subscription API
# at runtime; keep the private key secret. No Docker build arg is needed.
# NEXT_PUBLIC_WEB_PUSH_VAPID_PUBLIC_KEY=your-vapid-public-key
# WEB_PUSH_VAPID_PRIVATE_KEY=your-vapid-private-key
# WEB_PUSH_VAPID_SUBJECT=mailto:admin@example.com
#
# Push delivery is drained by the existing minute worker:
# The Docker and standalone launchers both run it when these are configured.
# APP_URL=https://crm.example.com
# AI_ANALYSIS_WORKER_SECRET=generate-a-long-random-string

# Durable outbound webhook worker. Required when you register API or n8n
# webhook endpoints. The standalone and Docker launchers run it every minute.
# WEBHOOK_DELIVERY_WORKER_SECRET=generate-a-different-long-random-string

# Platform-operator-only message retention purge (Platform page →
# "Mantenimiento"). No-op until an operator sets a retention window there.
# An external scheduler should POST once a day to
# /api/internal/message-retention (see scripts/run-message-retention-cron.mjs).

# Stripe AI credit top-ups. The estimated processing cost is included in the
# package price; no separate card surcharge is shown. Keep Checkout disabled
# until Stripe test mode has been validated. Never commit real keys.
# STRIPE_SECRET_KEY=sk_test_replace-with-a-test-secret
# STRIPE_WEBHOOK_SECRET=whsec_replace-with-the-endpoint-signing-secret
# STRIPE_CHECKOUT_ENABLED=false
# MESSAGE_RETENTION_CRON_SECRET=generate-a-different-long-random-string

# Meta App ID (Meta for Developers â†’ App Settings â†’ Basic). Required to
# create/edit message templates with an IMAGE header: Meta only accepts a
# Resumable-Upload media handle (not a plain URL) as the header sample, and
# that upload is app-scoped. Without it, image-header template submission
# returns a clear error; text/body-only templates are unaffected. Pair
# with META_APP_SECRET.
# META_APP_ID=your-meta-app-id

# When "true", POST /api/whatsapp/templates/submit skips the Meta call
# and stores the row with a synthetic `dry-run-<uuid>` meta_template_id.
# Set this in CI and local development so you can exercise the full
# template UI without a real WABA. Leave unset (or "false") in prod.
# WHATSAPP_TEMPLATES_DRY_RUN=true

# ------------------------------------------------------------------
# AI reply assistant (optional)
# ------------------------------------------------------------------
# The AI assistant is bring-your-own-key: each account pastes its own
# OpenAI or Anthropic key under Settings â†’ AI Assistant. The key is
# stored AES-256-GCM-encrypted with ENCRYPTION_KEY (above) â€” there is
# NO global provider key env var, and nothing here is required for the
# feature to work. The two vars below only tune behaviour.
#
# The AI knowledge base (migration 030) uses Postgres full-text search
# out of the box. Optional semantic search needs the `pgvector`
# extension â€” migration 030 runs `CREATE EXTENSION IF NOT EXISTS vector`
# (Supabase has it available) â€” plus a per-account embeddings key set in
# Settings â†’ AI Assistant. Still no env var required.

# Per-call timeout for provider requests, in milliseconds. Default 30000.
# AI_REQUEST_TIMEOUT_MS=30000

# How many recent text messages of a conversation to send the model as
# context (draft + auto-reply). Default 20.
# AI_CONTEXT_MESSAGE_LIMIT=20
# Keep disabled until the model evaluation is approved.
AI_TASK_ROUTING_ENABLED=false

# ------------------------------------------------------------------
# Reportes ejecutivos programados por Google Workspace SMTP (opcional)
# ------------------------------------------------------------------
# Los reportes se envÃ­an desde tu propia cuenta de Google Workspace. Activa
# la verificaciÃ³n en dos pasos para esa cuenta y crea una contraseÃ±a de
# aplicaciÃ³n de Google; nunca uses la contraseÃ±a normal del correo.
#
# En Google Workspace normalmente se usan estos valores. REPORTS_SMTP_HOST,
# REPORTS_SMTP_PORT y REPORTS_SMTP_SECURE se incluyen para operadores que
# utilicen otro servidor SMTP compatible.
# REPORTS_SMTP_HOST=smtp.gmail.com
# REPORTS_SMTP_PORT=465
# REPORTS_SMTP_SECURE=true
# REPORTS_SMTP_USER=andres.garcia@aurionova.com
# REPORTS_SMTP_PASS=contrasena-de-aplicacion-de-google
# REPORTS_EMAIL_FROM=NexoOmni Reportes <andres.garcia@aurionova.com>
#
# Alternativa administrada: configura SMTP Relay en Google Workspace y autoriza
# la IP pÃºblica del servidor NexoOmni. En ese caso usa:
# REPORTS_SMTP_HOST=smtp-relay.gmail.com
# REPORTS_SMTP_PORT=587
# REPORTS_SMTP_SECURE=false
# REPORTS_EMAIL_FROM=NexoOmni Reportes <andres.garcia@aurionova.com>
# y omite REPORTS_SMTP_USER y REPORTS_SMTP_PASS.
# OpenAI model routing defaults. Override only after measuring quality and
# spend for your own traffic; these variables are server-side only.
OPENAI_IMAGE_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
